#!/usr/bin/expect -f
# Drives the demo under asciinema with human-like pauses so the README recording is reproducible.
# usage (from the repository root): expect demo/record.exp <output.cast> <demo bundle>
set cast [lindex $argv 0]
set demo [lindex $argv 1]
set timeout 30
set stty_init "rows 20 columns 130"
set send_human {.1 .2 1 .05 .25}
log_user 0

spawn asciinema rec --overwrite --quiet --window-size 130x20 --command "sh demo/shell.sh $demo" $cast

expect "Select an AWS profile"
sleep 1.2
send "\033\[B"
sleep 0.5
send "\033\[B"
sleep 0.8
send "\r"

expect "Select an instance to connect"
sleep 3.5
send -h "api"
sleep 1.5
send "\033\[B"
sleep 0.8
send "\r"

expect -re {sh-5\.2\$ $}
sleep 1.0
send -h "hostname\r"
expect -re {sh-5\.2\$ $}
sleep 1.0
send -h "whoami\r"
expect -re {sh-5\.2\$ $}
sleep 1.5
send -h "exit\r"
expect eof
