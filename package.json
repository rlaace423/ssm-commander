{
  "name": "ssm-commander",
  "version": "1.0.0",
  "description": "Connect to EC2 instances and ECS containers by name through Session Manager and ECS Exec: interactive shell, port forwarding, ssh and scp across AWS profiles, without the AWS CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rlaace423/ssm-commander.git"
  },
  "homepage": "https://github.com/rlaace423/ssm-commander#readme",
  "bugs": {
    "url": "https://github.com/rlaace423/ssm-commander/issues"
  },
  "author": "Sangho Kim <rlaace423@gmail.com> (https://github.com/rlaace423)",
  "keywords": [
    "aws",
    "ssm",
    "session-manager",
    "ec2",
    "ecs",
    "ecs-exec",
    "cli",
    "port-forwarding",
    "ssh",
    "scp"
  ],
  "type": "module",
  "bin": {
    "ssm-commander": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node esbuild.config.mjs",
    "demo:gif": "sh demo/record.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:bundle": "node scripts/smoke-test.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:bundle"
  },
  "devDependencies": {
    "@aws-sdk/client-ec2": "^3.1164.0",
    "@aws-sdk/client-ecs": "^3.1164.0",
    "@aws-sdk/client-iam": "^3.1164.0",
    "@aws-sdk/client-ssm": "^3.1164.0",
    "@aws-sdk/client-sts": "^3.1164.0",
    "@aws-sdk/credential-providers": "^3.1164.0",
    "@biomejs/biome": "^2.6.6",
    "@inquirer/core": "^12.0.6",
    "@inquirer/figures": "^2.0.10",
    "@inquirer/prompts": "^8.7.5",
    "@inquirer/testing": "^3.3.16",
    "@inquirer/type": "^4.2.1",
    "@smithy/core": "^3.39.0",
    "@smithy/types": "^4.20.0",
    "@types/node": "^22.20.5",
    "commander": "^15.1.0",
    "esbuild": "^0.28.2",
    "ora": "^10.0.0",
    "string-width": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
